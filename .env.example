# Required: choose a long, unique password for the reservation dashboard.
MJ_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Recommended: generate a long random value and keep it private. This keeps
# signed-in admin sessions valid when the server restarts.
MJ_SESSION_SECRET=replace-with-a-long-random-secret

# Set true when the site is served through HTTPS (required for deployment).
# Set false only when testing locally at http://localhost:8000.
MJ_COOKIE_SECURE=true

# Optional email confirmations (Gmail account + Google App Password).
MJ_GMAIL_ADDRESS=reservations@example.com
MJ_GMAIL_APP_PASSWORD=replace-with-google-app-password
MJ_GMAIL_FROM_NAME=Masala Junction

# Required only for the Vercel version. Keep the service-role key private.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
